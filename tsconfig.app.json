{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite uchun) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting (Qat'iy tekshiruvlar) */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Yo'llarni qisqartirish (Aliaslar) */
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/api-client-react": ["./src/lib/api-client.ts"]
    }
  },
  "include": ["src", "../merchant talabapass/merchant-talabapass/src/pages/MerchantSignup.tsx", "../merchant talabapass/merchant-talabapass/src/pages/MerchantLogin.tsx"]
}